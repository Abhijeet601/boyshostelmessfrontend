# Shared API path. Vercel forwards it to the Railway backend using vercel.json.
VITE_API_BASE_URL=/api

# Development proxy target, loaded by vite.config.js.
VITE_PROXY_TARGET=https://boyshostelmessbackend-production.up.railway.app
# To use a locally running backend instead:
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# For a direct API connection on another frontend host, set before building:
# VITE_API_BASE_URL=https://boyshostelmessbackend-production.up.railway.app/api
